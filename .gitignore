!packages/*/android/
ios/
web/
macos/
linux/
windows/

# Local
*.log
.DS_Store

# graphify (graphe de connaissances local, régénérable)
graphify-out/

# Clés de signature release : ne jamais versionner (voir android/app/build.gradle.kts).
key.properties
**/key.properties
*.jks
*.keystore
