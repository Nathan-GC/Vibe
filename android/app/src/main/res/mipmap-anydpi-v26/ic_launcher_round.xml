<?xml version="1.0" encoding="utf-8"?>
<!-- Icône adaptative Vibe : fond noir pur plein cadre 108x108dp + 5 barres
     néon dans la zone de sécurité de 66dp. Le calque <monochrome> sert aux
     icônes à thème d'Android 13+ (activées par l'utilisateur dans les
     réglages du launcher) : l'anneau lavande observé en QA venait de la
     fonction "Applis suggérées" du Pixel Launcher, pas de ce calque. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
